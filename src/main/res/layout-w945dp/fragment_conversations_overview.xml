<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_view_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <LinearLayout
        android:id="@+id/conversation_list_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/color_background_primary"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/conversation_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="?android:attr/colorPrimary" >

            <TextView
                android:id="@+id/tab_chats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/title_chats"
                android:textAllCaps="true"
                android:textColor="@color/conversation_tab_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_rooms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/title_rooms"
                android:textAllCaps="true"
                android:textColor="@color/conversation_tab_text"
                android:textStyle="bold" />

        </LinearLayout>

        <de.timroes.android.listview.EnhancedListView
            android:id="@+id/list"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="?attr/color_background_primary"
            android:divider="@color/black12"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selected_conversation"
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="match_parent"
        android:orientation="vertical" >
    </LinearLayout>

</LinearLayout>
