<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/color_background_primary">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/local_video_view"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/call_switch_camera_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/call_overlay_button_background"
            android:contentDescription="@string/switch_camera"
            android:padding="12dp"
            android:src="@drawable/ic_action_switch_camera"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/call_speaker_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/call_overlay_button_background"
            android:contentDescription="@string/toggle_speaker"
            android:padding="12dp"
            android:src="@drawable/ic_action_speaker"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/call_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="64dp"
        android:paddingBottom="48dp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/call_photo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:riv_corner_radius="70dp" />

        <TextView
            android:id="@+id/call_display_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="?attr/color_text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/color_text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/call_decline_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/call_button_decline_background"
                android:contentDescription="@string/decline_call"
                android:padding="20dp"
                android:rotation="135"
                android:src="@drawable/ic_action_call"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/call_hangup_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/call_button_decline_background"
                android:contentDescription="@string/hangup_call"
                android:padding="20dp"
                android:rotation="135"
                android:src="@drawable/ic_action_call"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/call_accept_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="40dp"
                android:background="@drawable/call_button_accept_background"
                android:contentDescription="@string/accept_call"
                android:padding="20dp"
                android:src="@drawable/ic_action_call"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
